# ============================================================
# UniQuest Backend – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/uniquest

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Environment ---
ENVIRONMENT=development

# --- App ---
APP_NAME=UniQuest
APP_VERSION=1.0.0
DEBUG=true
